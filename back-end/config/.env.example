# Copy to config/.env and fill in the secrets. config/.env is git-ignored.

# ========================================
# DJANGO CONFIGURATION
# ========================================
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# One line per request in the runserver output: DEBUG, INFO, WARNING or ERROR.
# LOG_LEVEL=INFO
# Folder for the daily log file (renttrace-debug-YYYYMMDD.log, a new file each day).
# Default: back-end/Log/Debug. Set it empty to log to the console only.
# LOG_DIR=

# ========================================
# DATABASE — local PostgreSQL from docker-compose.yml
# ========================================
DB_NAME=renttrace
DB_USER=renttrace
DB_PASSWORD=renttrace
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable

# Supabase PostgreSQL (use instead of the block above when switching):
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<database password>
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_SSLMODE=require

# ========================================
# REDIS — cache and rate limits
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# UPLOADED FILES (property photos and documents)
# Folder where uploads are stored, outside version control. Back it up. Defaults to back-end/media.
# MEDIA_ROOT=

# API KEY
# Every /api/ request must send this in the X-API-Key header, signed in or not. Empty rejects everything.
# Generate one at /tools/random in the admin app (Hex, 64 or more), and give the same value to the admin app's API_KEY.
# API_KEY=

# JWT AUTHENTICATION
# ========================================
JWT_SIGNING_KEY=change-me

# ========================================
# SUPABASE — Google sign-in (optional: /api/auth/google/ returns 503 until set)
# ========================================
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=

# ========================================
# AUTH EMAILS (optional; defaults shown)
# ========================================
# Emails print to the runserver console until a real backend is set.
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# DEFAULT_FROM_EMAIL=RentTrace <no-reply@renttrace.local>
# Real sending through the Gmail API with OAuth 2.0 (no app password needed):
# EMAIL_BACKEND=accounts.integrations.gmail_backend.GmailApiBackend
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=   # from: python manage.py generate_gmail_refresh_token
# Where the link in reset emails points (app deep link or web URL).
# AUTH_LINK_BASE_URL=renttrace://auth
# Encrypts admins' authenticator secrets. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing it locks every enrolled admin out, so back it up. Empty turns two-step verification off (503).
# MFA_ENCRYPTION_KEY=
# Turns on POST /api/auth/bootstrap-admin/ to create the first super admin.
# Pick a long random value, then remove it once the super admin exists.
# ADMIN_BOOTSTRAP_SECRET=
# The Next web app. Verification emails link to its /verify-email page.
# WEB_APP_URL=http://localhost:3000
