# Copy to config/.env and fill in the secrets. config/.env is git-ignored.

# ========================================
# DJANGO CONFIGURATION
# ========================================
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ========================================
# DATABASE — local PostgreSQL from docker-compose.yml
# ========================================
DB_NAME=renttrace
DB_USER=renttrace
DB_PASSWORD=renttrace
DB_HOST=localhost
DB_PORT=5433
DB_SSLMODE=disable

# Supabase PostgreSQL (use instead of the block above when switching):
# DB_NAME=postgres
# DB_USER=postgres.<project-ref>
# DB_PASSWORD=<database password>
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_SSLMODE=require

# ========================================
# REDIS — cache and rate limits
# ========================================
REDIS_URL=redis://localhost:6379/0

# ========================================
# JWT AUTHENTICATION
# ========================================
JWT_SIGNING_KEY=change-me

# ========================================
# SUPABASE SSO (CONFIGURE LATER)
# ========================================
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
